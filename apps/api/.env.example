# ──────────────────────────────────────────────────────────────────────────────
# YayeTech Hotel Booking System — API Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────────────────────
# Get your connection string from https://neon.tech (free tier works)
DATABASE_URL="postgresql://user:password@host/dbname?schema=public"

# ── Redis (required) ─────────────────────────────────────────────────────────
# Local Docker:   redis://localhost:6379
# Upstash:        rediss://:token@endpoint.upstash.io:6380
REDIS_URL="redis://localhost:6379"

# ── JWT (required) ───────────────────────────────────────────────────────────
# Use a random string of at least 32 characters for each secret.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="change-me-to-a-random-32-plus-char-string"
JWT_REFRESH_SECRET="change-me-to-another-random-32-plus-char-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
MOCK_PAYMENT_WEBHOOK_SECRET="replace-with-a-strong-payment-webhook-secret"

# ── Payment Gateway & Chapa Configuration ────────────────────────────────────
# Provider switch: mock | chapa
PAYMENT_PROVIDER="mock"
CHAPA_PUBLIC_KEY="CHAPUBK_TEST-xxxxxxxxxxxxxxxxxxxx"
CHAPA_SECRET_KEY="CHASECK_TEST-xxxxxxxxxxxxxxxxxxxx"
CHAPA_ENCRYPTION_KEY="your-encryption-key"
CHAPA_WEBHOOK_SECRET="your-chapa-webhook-secret"

# ── Server (optional) ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"
# Set this to your deployed web app origin to enable CORS in production
WEB_ORIGIN=""
# Base URL of the web app — used for links embedded in emails (verification,
# password reset). Must be a single origin, NOT the CORS list in WEB_ORIGIN.
WEB_APP_URL="http://localhost:4000"

# ── Google OAuth (optional in dev) ───────────────────────────────────────────
# Pins the `aud` claim of ID tokens accepted by POST /auth/google so a token
# minted for another Google Cloud project cannot be replayed here.
# Include the Web client ID here; add native client IDs to GOOGLE_CLIENT_IDS.
# Leave empty to skip audience verification (development only).
GOOGLE_CLIENT_ID=""
# Optional comma-separated audiences for web and native Android clients.
GOOGLE_CLIENT_IDS=""
# Used to encrypt admin TOTP secrets at rest. Required in production.
MFA_ENCRYPTION_KEY="generate-a-random-32-plus-character-secret"

# ── Cloudinary — image uploads (optional in dev) ─────────────────────────────
# Without these, image uploads will use local disk storage.
# Sign up free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Email — transactional notifications (optional in dev) ────────────────────
# Without these, email jobs are queued but silently no-op on delivery.
# Example: Gmail SMTP with an App Password
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="noreply@yayetech.com"

# ── AI assistant (server-side only) ──────────────────────────────────────────
# Provider switch: mock | gemini. Never expose GEMINI_API_KEY to clients.
AI_PROVIDER="mock"
# Served when the primary provider errors after retries: mock | gemini | none.
# "none" keeps the plain "assistant temporarily unavailable" apology (AI-023).
AI_PROVIDER_FALLBACK="mock"
GEMINI_API_KEY=""
# Optional. Defaults to gemini-flash-latest when unset.
# Note: on this project gemini-flash-latest is subject to a ~20/day free-tier
# quota and returns 429 once exhausted; gemini-flash-lite-latest still works.
GEMINI_MODEL=""
AI_CONVERSATION_HISTORY_LIMIT=20
AI_MAX_TOOL_ITERATIONS=5
AI_RATE_LIMIT_PER_USER=60

AI_CONVERSATION_RETENTION_DAYS=90
AI_TTS_MODEL="gemini-2.5-flash-preview-tts"
AI_TTS_VOICE="Kore"
# Bounded retry for transient Gemini throttling (HTTP 429/503 only).
# Counted as extra attempts after the first; set 0 to disable retrying.
AI_RETRY_MAX_RETRIES=2
# Exponential backoff seed in ms; Google's Retry-After header overrides it.
AI_RETRY_BASE_DELAY_MS=400
