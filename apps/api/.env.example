# ──────────────────────────────────────────────────────────────────────────────
# YayeTech Hotel Booking System — API Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────────────────────
# Get your connection string from https://neon.tech (free tier works)
DATABASE_URL="postgresql://user:password@host/dbname?schema=public"

# ── Redis (required) ─────────────────────────────────────────────────────────
# Local Docker:   redis://localhost:6379
# Upstash:        rediss://:token@endpoint.upstash.io:6380
REDIS_URL="redis://localhost:6379"

# ── JWT (required) ───────────────────────────────────────────────────────────
# Use a random string of at least 32 characters for each secret.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="change-me-to-a-random-32-plus-char-string"
JWT_REFRESH_SECRET="change-me-to-another-random-32-plus-char-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
MOCK_PAYMENT_WEBHOOK_SECRET="replace-with-a-strong-payment-webhook-secret"

# ── Server (optional) ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"
# Set this to your deployed web app origin to enable CORS in production
WEB_ORIGIN=""

# ── Cloudinary — image uploads (optional in dev) ─────────────────────────────
# Without these, image uploads will use local disk storage.
# Sign up free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Email — transactional notifications (optional in dev) ────────────────────
# Without these, email jobs are queued but silently no-op on delivery.
# Example: Gmail SMTP with an App Password
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="noreply@yayetech.com"
