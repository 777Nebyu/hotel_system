generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  STAFF
  MANAGER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  REJECTED
  NO_SHOW
}

enum RoomStatus {
  AVAILABLE
  UNAVAILABLE
  MAINTENANCE
  CLEANING
}

enum PaymentStatus {
  PENDING
  PENDING_AT_HOTEL
  PROCESSING
  OTP_SENT
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  TIMEOUT
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum BookingSource {
  ONLINE
  WALK_IN
}

enum HotelStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  REJECTED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum SuspensionRequestStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum UserStatus {
  ACTIVE
  EMAIL_UNVERIFIED
  SUSPENDED
  DEACTIVATED
  DELETED
}

model User {
  id                         String                   @id @default(cuid())
  email                      String                   @unique
  googleId                   String?                  @unique // verified Google subject (sub); null = not linked
  passwordHash               String
  fullName                   String
  phone                      String?
  role                       Role                     @default(CUSTOMER)
  isActive                   Boolean                  @default(true)
  status                     UserStatus               @default(ACTIVE)
  deletedAt                  DateTime?
  deletionScheduledFor       DateTime?
  profilePhotoUrl            String?
  emailVerified              Boolean                  @default(false) // compatibility mirror; emailVerifiedAt is canonical
  emailVerifiedAt            DateTime?
  verificationToken          String?                  @unique
  verificationTokenExpiresAt DateTime?
  resetPasswordToken         String?                  @unique
  resetPasswordExpiresAt     DateTime?
  refreshTokenHash           String?
  refreshTokenFamily         String?
  lastLoginAt                DateTime?
  loginAttempts              Int                      @default(0)
  lockedUntil                DateTime?
  mfaEnabled                 Boolean                  @default(false)
  mfaSecretEncrypted         String?
  mfaPendingSecretEncrypted  String?
  mfaChallengeHash           String?                  @unique
  mfaChallengeExpiresAt      DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  pushToken                  String?
  isFlagged                  Boolean                  @default(false)
  flagReason                 String?
  flaggedAt                  DateTime?
  hotels                     Hotel[]                  @relation("HotelManager")
  staffHotels                StaffHotel[]
  sessions                   UserSession[]
  bookings                   Booking[]
  reviews                    Review[]
  reviewResponses            Review[]                 @relation("ReviewResponder")
  favorites                  Favorite[]
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  auditLogs                  AuditLog[]
  disputesOpened             Dispute[]                @relation("DisputeOpener")
  suspensionRequestsMade     SuspensionRequest[]      @relation("SuspensionRequester")
  suspensionRequestsApproved SuspensionRequest[]      @relation("SuspensionApprover")
  roomHolds                  RoomHold[]
  stayRequestsDecided        StayRequest[]            @relation("StayRequestDecider")
  bookingModifications       BookingModification[]    @relation("BookingModificationRequester")
  roomRelocations            RoomRelocation[]         @relation("RoomRelocator")
  contactThreads             ContactThread[]          @relation("CustomerContactThreads")
  sentContactMessages        ContactMessage[]         @relation("SentContactMessages")
  aiConversations            AiConversation[]
  trips                      Trip[]
}

model Country {
  id     String @id @default(cuid())
  name   String @unique
  code   String @unique
  cities City[]
}

model City {
  id        String  @id @default(cuid())
  name      String
  countryId String
  country   Country @relation(fields: [countryId], references: [id])
  hotels    Hotel[]
  places    Place[]

  @@unique([name, countryId])
}

model Hotel {
  id                String                @id @default(cuid())
  managerId         String?
  manager           User?                 @relation("HotelManager", fields: [managerId], references: [id])
  cityId            String
  city              City                  @relation(fields: [cityId], references: [id])
  name              String
  description       String
  address           String
  lat               Float?
  lng               Float?
  starRating        Int                   @default(3)
  status            HotelStatus           @default(PENDING_APPROVAL)
  rejectionReason   String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  policy            HotelPolicy?
  images            HotelImage[]
  amenities         HotelAmenity[]
  rooms             Room[]
  bookings          Booking[]
  reviews           Review[]
  favorites         Favorite[]
  staffAssignments  StaffHotel[]
  statusHistory     HotelStatusHistory[]
  contactThreads    ContactThread[]       @relation("HotelContactThreads")
  aiConversations   AiConversation[]
  aiDocuments       AiKnowledgeDocument[]
  emergencyContacts EmergencyContact[]
  trips             Trip[]
}

model HotelImage {
  id        String  @id @default(cuid())
  hotelId   String
  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean @default(false)
}

model Amenity {
  id             String         @id @default(cuid())
  name           String         @unique
  category       String         @default("GENERAL")
  icon           String?
  hotelAmenities HotelAmenity[]
  roomAmenities  RoomAmenity[]
}

model HotelAmenity {
  hotelId   String
  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  amenityId String
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([hotelId, amenityId])
}

model Room {
  id              String             @id @default(cuid())
  hotelId         String
  hotel           Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomNumber      String
  type            String
  capacity        Int
  beds            Int                @default(1)
  bathroom        Int                @default(1)
  basePrice       Decimal            @db.Decimal(10, 2)
  status          RoomStatus         @default(AVAILABLE)
  description     String?
  images          RoomImage[]
  amenities       RoomAmenity[]
  availability    RoomAvailability[]
  seasonalPricing SeasonalPricing[]
  details         BookingDetail[]
  roomHolds       RoomHold[]
  relocationsFrom RoomRelocation[]   @relation("RelocatedFromRoom")
  relocationsTo   RoomRelocation[]   @relation("RelocatedToRoom")

  @@unique([hotelId, roomNumber])
}

model RoomImage {
  id        String  @id @default(cuid())
  roomId    String
  room      Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean @default(false)
}

model RoomAmenity {
  roomId    String
  room      Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  amenityId String
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomId, amenityId])
}

model RoomAvailability {
  id     String     @id @default(cuid())
  roomId String
  room   Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date   DateTime   @db.Date
  status RoomStatus @default(AVAILABLE)

  @@unique([roomId, date])
}

model SeasonalPricing {
  id            String   @id @default(cuid())
  roomId        String
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  startDate     DateTime @db.Date
  endDate       DateTime @db.Date
  priceOverride Decimal  @db.Decimal(10, 2)
}

model Booking {
  id              String                 @id @default(cuid())
  bookingRef      String                 @unique
  userId          String
  user            User                   @relation(fields: [userId], references: [id])
  hotelId         String
  hotel           Hotel                  @relation(fields: [hotelId], references: [id])
  checkIn         DateTime               @db.Date
  checkOut        DateTime               @db.Date
  status          BookingStatus          @default(PENDING)
  totalPrice      Decimal                @db.Decimal(10, 2)
  subtotal        Decimal                @default(0.00) @db.Decimal(10, 2)
  serviceFee      Decimal                @default(0.00) @db.Decimal(10, 2)
  discount        Decimal                @default(0.00) @db.Decimal(10, 2)
  taxRate         Decimal                @default(0.15) @db.Decimal(5, 2)
  taxAmount       Decimal                @default(0.00) @db.Decimal(10, 2)
  bookingSource   BookingSource          @default(ONLINE)
  deletedAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  details         BookingDetail[]
  payment         Payment?
  review          Review?
  disputes        Dispute[]
  actualCheckIn   DateTime?
  actualCheckOut  DateTime?
  earlyCheckIn    Boolean                @default(false)
  earlyCheckInFee Decimal?               @db.Decimal(10, 2)
  lateCheckOut    Boolean                @default(false)
  lateCheckOutFee Decimal?               @db.Decimal(10, 2)
  stayRequests    StayRequest[]
  statusHistory   BookingStatusHistory[]
  modifications   BookingModification[]
  relocations     RoomRelocation[]
  contactThreads  ContactThread[]
  paymentAttempts PaymentAttempt[]
  trips           Trip[]
  tripItems       TripItem[]

  @@index([userId])
  @@index([hotelId])
  @@index([status])
  @@index([checkIn, checkOut])
  @@index([bookingRef])
  @@index([deletedAt])
}

model BookingDetail {
  id               String    @id @default(cuid())
  bookingId        String
  booking          Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomId           String
  room             Room      @relation(fields: [roomId], references: [id])
  guestCount       Int
  guestInfo        Json
  roomSnapshot     Json?
  checkIn          DateTime  @db.Date
  checkOut         DateTime  @db.Date
  relocatedFrom    String?
  relocationReason String?
  relocatedAt      DateTime?
  relocatedBy      String?
}

model BookingStatusHistory {
  id         String        @id @default(cuid())
  bookingId  String
  booking    Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus BookingStatus
  toStatus   BookingStatus
  status     String?
  reason     String?
  changedBy  String?
  actorId    String?
  createdAt  DateTime      @default(now())

  @@index([bookingId])
  @@index([createdAt(sort: Desc)])
}

model HotelStatusHistory {
  id        String      @id @default(cuid())
  hotelId   String
  hotel     Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  status    HotelStatus
  changedBy String
  reason    String?
  createdAt DateTime    @default(now())

  @@index([hotelId])
}

model Payment {
  id                    String           @id @default(cuid())
  bookingId             String           @unique
  booking               Booking          @relation(fields: [bookingId], references: [id])
  userId                String?
  provider              String           @default("CHAPA")
  method                String
  amount                Decimal          @db.Decimal(10, 2)
  currency              String           @default("ETB")
  status                PaymentStatus    @default(PENDING)
  txRef                 String?          @unique
  providerRef           String?          @unique
  checkoutSessionId     String?
  bankCode              String?
  transactionId         String?
  verificationCodeHash  String?
  verificationExpiresAt DateTime?
  verificationAttempts  Int              @default(0)
  idempotencyKey        String?          @unique
  failureReason         String?
  metadata              Json?
  invoiceUrl            String?
  refundAmount          Decimal?         @db.Decimal(10, 2)
  refundedAt            DateTime?
  completedAt           DateTime?
  deletedAt             DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @default(now()) @updatedAt
  attempts              PaymentAttempt[]
  events                PaymentEvent[]

  @@index([status])
  @@index([txRef])
  @@index([idempotencyKey])
  @@index([createdAt(sort: Desc)])
  @@index([deletedAt])
}

model PaymentEvent {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  eventType String
  status    String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([eventType])
  @@index([createdAt(sort: Desc)])
}

model PaymentAttempt {
  id           String   @id @default(cuid())
  bookingId    String
  booking      Booking  @relation(fields: [bookingId], references: [id])
  paymentId    String?
  payment      Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  method       String
  outcome      String   @default("INITIATED")
  status       String   @default("INITIATED")
  amount       Decimal  @db.Decimal(10, 2)
  providerRef  String?
  errorMessage String?
  error        String?
  attemptedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([paymentId])
  @@index([bookingId])
}

model Review {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  hotelId       String
  hotel         Hotel     @relation(fields: [hotelId], references: [id])
  bookingId     String?   @unique
  booking       Booking?  @relation(fields: [bookingId], references: [id])
  rating        Int
  comment       String
  photos        Json?
  response      String?
  respondedAt   DateTime?
  respondedById String?
  respondedBy   User?     @relation("ReviewResponder", fields: [respondedById], references: [id])
  flagged       Boolean   @default(false)
  flagReason    String?
  flaggedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([hotelId])
  @@index([userId])
}

model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, hotelId])
}

model Coupon {
  id               String       @id @default(cuid())
  code             String       @unique
  discountType     DiscountType @default(PERCENTAGE)
  value            Decimal      @db.Decimal(10, 2)
  validFrom        DateTime
  validTo          DateTime
  usageLimit       Int          @default(100)
  timesUsed        Int          @default(0)
  isActive         Boolean      @default(true)
  minBookingAmount Decimal?     @db.Decimal(10, 2)
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  channel   String
  payload   Json
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  diff      Json?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([entity, entityId])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model HotelPolicy {
  id                     String   @id @default(cuid())
  hotelId                String   @unique
  hotel                  Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  checkInTime            String   @default("14:00")
  checkOutTime           String   @default("11:00")
  cancellationWindowDays Int      @default(3)
  cancellationFeePercent Decimal  @default(0.00) @db.Decimal(5, 2)
  allowEarlyCheckIn      Boolean  @default(true)
  earlyCheckInFee        Decimal  @default(0.00) @db.Decimal(10, 2)
  allowLateCheckOut      Boolean  @default(true)
  lateCheckOutFee        Decimal  @default(0.00) @db.Decimal(10, 2)
  taxRate                Decimal  @default(0.15) @db.Decimal(5, 2)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  channel   String   @default("EMAIL")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type, channel])
  @@index([userId])
}

model StaffHotel {
  staffId    String
  staff      User     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  hotelId    String
  hotel      Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  role       String   @default("Front Desk")
  assignedAt DateTime @default(now())

  @@id([staffId, hotelId])
  @@index([hotelId])
}

model Dispute {
  id         String        @id @default(cuid())
  bookingId  String
  booking    Booking       @relation(fields: [bookingId], references: [id])
  openedById String
  openedBy   User          @relation("DisputeOpener", fields: [openedById], references: [id])
  reason     String
  status     DisputeStatus @default(OPEN)
  resolution String?
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([bookingId])
  @@index([status])
}

model SuspensionRequest {
  id          String                  @id @default(cuid())
  requesterId String
  requester   User                    @relation("SuspensionRequester", fields: [requesterId], references: [id])
  approverId  String?
  approver    User?                   @relation("SuspensionApprover", fields: [approverId], references: [id])
  targetType  String
  targetId    String
  reason      String
  status      SuspensionRequestStatus @default(PENDING_APPROVAL)
  decidedAt   DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([status])
  @@index([targetType, targetId])
}

enum StayRequestType {
  EARLY_CHECKIN
  LATE_CHECKOUT
}

enum StayRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model RoomHold {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIn   DateTime @db.Date
  checkOut  DateTime @db.Date
  holdStart DateTime @default(now())
  holdEnd   DateTime
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  @@index([roomId, holdEnd])
  @@index([userId, status])
}

model StayRequest {
  id            String            @id @default(cuid())
  bookingId     String
  booking       Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type          StayRequestType
  status        StayRequestStatus @default(PENDING)
  requestedTime String?
  fee           Decimal           @default(0.00) @db.Decimal(10, 2)
  guestConsent  Boolean           @default(false)
  decisionNote  String?
  decidedById   String?
  decidedBy     User?             @relation("StayRequestDecider", fields: [decidedById], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([bookingId])
  @@index([status])
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  family           String
  deviceName       String?
  userAgent        String?
  ipAddress        String?
  lastActiveAt     DateTime  @default(now())
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?

  @@index([userId, revokedAt])
  @@index([family])
}

model BookingModification {
  id                 String   @id @default(cuid())
  bookingId          String
  booking            Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  requestedById      String
  requestedBy        User     @relation("BookingModificationRequester", fields: [requestedById], references: [id])
  previousCheckIn    DateTime @db.Date
  previousCheckOut   DateTime @db.Date
  newCheckIn         DateTime @db.Date
  newCheckOut        DateTime @db.Date
  previousTotalPrice Decimal  @db.Decimal(10, 2)
  newTotalPrice      Decimal  @db.Decimal(10, 2)
  priceDifference    Decimal  @db.Decimal(10, 2)
  reason             String?
  createdAt          DateTime @default(now())

  @@index([bookingId])
  @@index([requestedById])
}

model RoomRelocation {
  id              String   @id @default(cuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingDetailId String
  oldRoomId       String
  oldRoom         Room     @relation("RelocatedFromRoom", fields: [oldRoomId], references: [id])
  newRoomId       String
  newRoom         Room     @relation("RelocatedToRoom", fields: [newRoomId], references: [id])
  reason          String
  relocatedById   String
  relocatedBy     User     @relation("RoomRelocator", fields: [relocatedById], references: [id])
  relocatedAt     DateTime @default(now())

  @@index([bookingId])
  @@index([oldRoomId])
  @@index([newRoomId])
}

enum ContactStatus {
  OPEN
  CLOSED
}

model ContactThread {
  id         String           @id @default(cuid())
  customerId String
  customer   User             @relation("CustomerContactThreads", fields: [customerId], references: [id])
  hotelId    String
  hotel      Hotel            @relation("HotelContactThreads", fields: [hotelId], references: [id], onDelete: Cascade)
  bookingId  String?
  booking    Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  subject    String
  status     ContactStatus    @default(OPEN)
  messages   ContactMessage[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([customerId])
  @@index([hotelId])
  @@index([bookingId])
}

model ContactMessage {
  id        String        @id @default(cuid())
  threadId  String
  thread    ContactThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation("SentContactMessages", fields: [senderId], references: [id])
  content   String
  readAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([threadId])
  @@index([senderId])
}

model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotelId   String?
  hotel     Hotel?      @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  title     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]

  @@index([userId])
  @@index([hotelId])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String         @db.Text
  toolCalls      Json?
  toolResults    Json?
  createdAt      DateTime       @default(now())

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

model AiKnowledgeDocument {
  id        String   @id @default(cuid())
  hotelId   String?
  hotel     Hotel?   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hotelId])
  @@index([approved])
  @@index([approved, hotelId, updatedAt])
}

model AiAuditLog {
  id            String   @id @default(cuid())
  actorId       String
  actorRole     String
  hotelId       String?
  toolName      String
  arguments     Json
  resultSummary String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([actorId])
  @@index([hotelId])
  @@index([createdAt])
}

enum PlaceCategory {
  RESTAURANT
  CAFE
  HERITAGE
  MUSEUM
  ATTRACTION
  NIGHTLIFE
  SHOPPING
  HOSPITAL
  CLINIC
  PHARMACY
  EMERGENCY
  OTHER
}

enum PlaceStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

model Source {
  id                String             @id @default(cuid())
  name              String
  url               String?
  license           String?
  verifiedBy        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  places            Place[]
  emergencyContacts EmergencyContact[]
}

model Place {
  id                 String        @id @default(cuid())
  name               String
  amharicName        String?
  description        String        @db.Text
  amharicDescription String?       @db.Text
  category           PlaceCategory
  status             PlaceStatus   @default(PUBLISHED)
  address            String
  lat                Float
  lng                Float
  cityId             String?
  city               City?         @relation(fields: [cityId], references: [id], onDelete: SetNull)
  phone              String?
  website            String?
  openingHours       String?
  hoursVerified      Boolean       @default(false)
  priceLevel         Int?          @default(1)
  rating             Float?        @default(4.5)
  images             Json?
  sourceId           String?
  source             Source?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  lastVerifiedAt     DateTime?     @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  tripItems          TripItem[]

  @@index([category])
  @@index([status])
  @@index([cityId])
  @@index([lat, lng])
}

enum TripItemType {
  PLACE
  BOOKING
  CUSTOM
}

enum TripItemStatus {
  PLANNED
  DONE
  SKIPPED
}

enum CreatedByOrigin {
  USER
  AI
}

model Trip {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  hotelId   String?
  hotel     Hotel?     @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  bookingId String?
  booking   Booking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  startDate DateTime   @db.Date
  endDate   DateTime   @db.Date
  timezone  String     @default("Africa/Addis_Ababa")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  items     TripItem[]

  @@index([userId, startDate])
}

model TripItem {
  id             String          @id @default(cuid())
  tripId         String
  trip           Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayDate        DateTime        @db.Date
  startTime      String?
  durationMin    Int?
  itemType       TripItemType
  placeId        String?
  place          Place?          @relation(fields: [placeId], references: [id], onDelete: SetNull)
  bookingId      String?
  booking        Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  title          String
  notes          String?         @db.Text
  costAmount     Decimal?        @db.Decimal(10, 2)
  currency       String?         @default("ETB")
  status         TripItemStatus  @default(PLANNED)
  position       Int             @default(0)
  createdBy      CreatedByOrigin @default(USER)
  reminderSentAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([tripId, dayDate, startTime])
}

model EmergencyContact {
  id             String   @id @default(cuid())
  city           String?
  hotelId        String?
  hotel          Hotel?   @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  kind           String // POLICE | AMBULANCE | FIRE | HOTEL | EMBASSY | OTHER
  name           String
  phone          String
  sourceId       String?
  source         Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  lastVerifiedAt DateTime @default(now())
  status         String   @default("PUBLISHED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([city])
  @@index([hotelId])
  @@index([kind])
  @@index([status])
}
