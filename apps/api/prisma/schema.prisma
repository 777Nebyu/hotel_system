generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  STAFF
  MANAGER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  REJECTED
  NO_SHOW
}

enum RoomStatus {
  AVAILABLE
  UNAVAILABLE
  MAINTENANCE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum BookingSource {
  ONLINE
  WALK_IN
}

enum HotelStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  REJECTED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum SuspensionRequestStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id                     String         @id @default(cuid())
  email                  String         @unique
  passwordHash           String
  fullName               String
  phone                  String?
  role                   Role           @default(CUSTOMER)
  isActive               Boolean        @default(true)
  profilePhotoUrl        String?
  emailVerifiedAt        DateTime?
  verificationToken      String?        @unique
  resetPasswordToken     String?        @unique
  resetPasswordExpiresAt DateTime?
  refreshTokenHash       String?
  refreshTokenFamily     String?
  lastLoginAt            DateTime?
  loginAttempts          Int            @default(0)
  lockedUntil            DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  pushToken              String?
  hotels                     Hotel[]                    @relation("HotelManager")
  staffHotels                StaffHotel[]
  bookings                   Booking[]
  reviews                    Review[]
  favorites                  Favorite[]
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  auditLogs                  AuditLog[]
  disputesOpened             Dispute[]                  @relation("DisputeOpener")
  suspensionRequestsMade     SuspensionRequest[]        @relation("SuspensionRequester")
  suspensionRequestsApproved SuspensionRequest[]        @relation("SuspensionApprover")
  roomHolds                  RoomHold[]
  stayRequestsDecided        StayRequest[]              @relation("StayRequestDecider")
}

model Country {
  id     String @id @default(cuid())
  name   String @unique
  code   String @unique
  cities City[]
}

model City {
  id        String  @id @default(cuid())
  name      String
  countryId String
  country   Country @relation(fields: [countryId], references: [id])
  hotels    Hotel[]

  @@unique([name, countryId])
}

model Hotel {
  id          String         @id @default(cuid())
  managerId   String?
  manager     User?          @relation("HotelManager", fields: [managerId], references: [id])
  cityId      String
  city        City           @relation(fields: [cityId], references: [id])
  name        String
  description String
  address     String
  lat         Float?
  lng         Float?
  starRating      Int            @default(3)
  status          HotelStatus    @default(PENDING_APPROVAL)
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  policy           HotelPolicy?
  images           HotelImage[]
  amenities        HotelAmenity[]
  rooms            Room[]
  bookings         Booking[]
  reviews          Review[]
  favorites        Favorite[]
  staffAssignments StaffHotel[]
}

model HotelImage {
  id        String  @id @default(cuid())
  hotelId   String
  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean @default(false)
}

model Amenity {
  id             String         @id @default(cuid())
  name           String         @unique
  category       String         @default("GENERAL")
  icon           String?
  hotelAmenities HotelAmenity[]
  roomAmenities  RoomAmenity[]
}

model HotelAmenity {
  hotelId   String
  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  amenityId String
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([hotelId, amenityId])
}

model Room {
  id               String             @id @default(cuid())
  hotelId          String
  hotel            Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomNumber       String
  type             String
  capacity         Int
  beds             Int                @default(1)
  bathroom         Int                @default(1)
  basePrice        Decimal            @db.Decimal(10, 2)
  status           RoomStatus         @default(AVAILABLE)
  description      String?
  images           RoomImage[]
  amenities        RoomAmenity[]
  availability     RoomAvailability[]
  seasonalPricing  SeasonalPricing[]
  details          BookingDetail[]
  roomHolds        RoomHold[]

  @@unique([hotelId, roomNumber])
}

model RoomImage {
  id        String  @id @default(cuid())
  roomId    String
  room      Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean @default(false)
}

model RoomAmenity {
  roomId    String
  room      Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  amenityId String
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomId, amenityId])
}

model RoomAvailability {
  id     String     @id @default(cuid())
  roomId String
  room   Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date   DateTime   @db.Date
  status RoomStatus @default(AVAILABLE)

  @@unique([roomId, date])
}

model SeasonalPricing {
  id            String   @id @default(cuid())
  roomId        String
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  startDate     DateTime @db.Date
  endDate       DateTime @db.Date
  priceOverride Decimal  @db.Decimal(10, 2)
}

model Booking {
  id            String        @id @default(cuid())
  bookingRef    String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  hotelId       String
  hotel         Hotel         @relation(fields: [hotelId], references: [id])
  checkIn       DateTime      @db.Date
  checkOut      DateTime      @db.Date
  status        BookingStatus @default(PENDING)
  totalPrice    Decimal       @db.Decimal(10, 2)
  bookingSource BookingSource @default(ONLINE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  details         BookingDetail[]
  payment         Payment?
  review          Review?
  disputes        Dispute[]
  actualCheckIn   DateTime?
  actualCheckOut  DateTime?
  earlyCheckIn    Boolean         @default(false)
  earlyCheckInFee Decimal?        @db.Decimal(10, 2)
  lateCheckOut    Boolean         @default(false)
  lateCheckOutFee Decimal?        @db.Decimal(10, 2)
  stayRequests    StayRequest[]

  @@index([userId])
  @@index([hotelId])
  @@index([status])
  @@index([checkIn, checkOut])
  @@index([bookingRef])
}

model BookingDetail {
  id               String    @id @default(cuid())
  bookingId        String
  booking          Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomId           String
  room             Room      @relation(fields: [roomId], references: [id])
  guestCount       Int
  guestInfo        Json
  relocatedFrom    String?
  relocationReason String?
  relocatedAt      DateTime?
  relocatedBy      String?
}

model Payment {
  id           String           @id @default(cuid())
  bookingId    String           @unique
  booking      Booking          @relation(fields: [bookingId], references: [id])
  method       String
  amount       Decimal          @db.Decimal(10, 2)
  status       PaymentStatus    @default(PENDING)
  providerRef  String?
  invoiceUrl   String?
  refundAmount Decimal?         @db.Decimal(10, 2)
  refundedAt   DateTime?
  createdAt    DateTime         @default(now())
  attempts     PaymentAttempt[]

  @@index([status])
}

model PaymentAttempt {
  id           String   @id @default(cuid())
  paymentId    String
  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  method       String
  outcome      String
  providerRef  String?
  errorMessage String?
  attemptedAt  DateTime @default(now())

  @@index([paymentId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id])
  rating    Int
  comment   String
  photos    Json?
  createdAt DateTime @default(now())

  @@index([hotelId])
  @@index([userId])
}

model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, hotelId])
}

model Coupon {
  id               String       @id @default(cuid())
  code             String       @unique
  discountType     DiscountType @default(PERCENTAGE)
  value            Decimal      @db.Decimal(10, 2)
  validFrom        DateTime
  validTo          DateTime
  usageLimit       Int          @default(100)
  timesUsed        Int          @default(0)
  isActive         Boolean      @default(true)
  minBookingAmount Decimal?     @db.Decimal(10, 2)
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  channel   String
  payload   Json
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  diff      Json?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([entity, entityId])
}

  model PlatformSetting {
    key       String   @id
    value     Json
    updatedAt DateTime @updatedAt
  }

model HotelPolicy {
  id                     String   @id @default(cuid())
  hotelId                String   @unique
  hotel                  Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  checkInTime            String   @default("14:00")
  checkOutTime           String   @default("11:00")
  cancellationWindowDays Int      @default(3)
  cancellationFeePercent Decimal  @default(0.00) @db.Decimal(5, 2)
  allowEarlyCheckIn      Boolean  @default(true)
  earlyCheckInFee        Decimal  @default(0.00) @db.Decimal(10, 2)
  allowLateCheckOut      Boolean  @default(true)
  lateCheckOutFee        Decimal  @default(0.00) @db.Decimal(10, 2)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  channel   String   @default("EMAIL")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type, channel])
  @@index([userId])
}

model StaffHotel {
  staffId    String
  staff      User     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  hotelId    String
  hotel      Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([staffId, hotelId])
  @@index([hotelId])
}

model Dispute {
  id         String        @id @default(cuid())
  bookingId  String
  booking    Booking       @relation(fields: [bookingId], references: [id])
  openedById String
  openedBy   User          @relation("DisputeOpener", fields: [openedById], references: [id])
  reason     String
  status     DisputeStatus @default(OPEN)
  resolution String?
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([bookingId])
  @@index([status])
}

model SuspensionRequest {
  id          String                  @id @default(cuid())
  requesterId String
  requester   User                    @relation("SuspensionRequester", fields: [requesterId], references: [id])
  approverId  String?
  approver    User?                   @relation("SuspensionApprover", fields: [approverId], references: [id])
  targetType  String
  targetId    String
  reason      String
  status      SuspensionRequestStatus @default(PENDING_APPROVAL)
  decidedAt   DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([status])
  @@index([targetType, targetId])
}

enum StayRequestType {
  EARLY_CHECKIN
  LATE_CHECKOUT
}

enum StayRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model RoomHold {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIn   DateTime @db.Date
  checkOut  DateTime @db.Date
  holdStart DateTime @default(now())
  holdEnd   DateTime
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  @@index([roomId, holdEnd])
  @@index([userId, status])
}

model StayRequest {
  id            String            @id @default(cuid())
  bookingId     String
  booking       Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type          StayRequestType
  status        StayRequestStatus @default(PENDING)
  requestedTime String?
  fee           Decimal           @default(0.00) @db.Decimal(10, 2)
  guestConsent  Boolean           @default(false)
  decisionNote  String?
  decidedById   String?
  decidedBy     User?             @relation("StayRequestDecider", fields: [decidedById], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([bookingId])
  @@index([status])
}
