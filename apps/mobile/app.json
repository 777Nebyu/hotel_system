{
  "expo": {
    "name": "YayeTech Hotel",
    "slug": "yayetech-hotel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "yayetechhotel",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1f6f64"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yayetech.hotel",
      "config": { "usesNonExemptEncryption": false },
      "associatedDomains": ["applinks:yayetech.com"]
    },
    "android": {
      "package": "com.yayetech.hotel",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1f6f64"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [{ "scheme": "yayetechhotel" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      ["expo-secure-store", { "configureAndroidBackup": true }],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1f6f64"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow YayeTech Hotel to use Face ID for quick unlock."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
