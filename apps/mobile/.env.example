# API base URL — no trailing slash.
# Android emulator: http://10.0.2.2:3001
# iOS simulator:    http://localhost:3001
# Physical device:  use your machine's LAN IP, e.g. http://192.168.1.10:3001
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001

# Mock payment gateway secret (dev/staging only — NEVER set in production).
# Must match the value configured in the backend PaymentsModule.
EXPO_PUBLIC_MOCK_PAYMENT_SECRET=your_mock_secret_here

# Google OAuth client ID used by "Continue with Google".
# Web uses this client; Android uses EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID.
# Both audiences must be listed in the backend GOOGLE_CLIENT_IDS setting.
# Leave empty to disable the button: the app then fails fast with
# "Google sign-in is not configured for this app." instead of opening a
# browser that can never complete the flow.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Android OAuth client created with package com.luxsty.hotel and the
# development/EAS SHA-1 fingerprint.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
